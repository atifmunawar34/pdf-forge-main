# ---- Frontend (Vite) ---------------------------------------------------
# Base URL the SPA uses to reach the conversion API.
# Leave empty (or omit) to use same-origin requests.
VITE_API_BASE_URL=

# ---- Backend (backend/server.js) ---------------------------------------
# Port the API listens on (default 5000).
# PORT=5000

# Comma-separated list of allowed CORS origins for production.
# localhost / private-LAN dev origins are always allowed.
# CORS_ORIGINS=https://ilovetopdf.com,https://www.ilovetopdf.com

# Required to read GET /api/inquiries (send as x-admin-key header).
# Without it, that endpoint stays disabled (403) — POST still works.
# ADMIN_KEY=change-me-to-a-long-random-string

# AI Assistant proxy — all three optional; without a key the endpoint
# returns 503 {offline:true} and the frontend falls back gracefully.
# AI_API_KEY=sk-...
# AI_API_BASE=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Max wall-clock ms for one Python/LibreOffice conversion (default 300000).
# PYTHON_TIMEOUT_MS=300000
